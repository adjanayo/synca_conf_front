# URL de l'API backend (synca_conf_back). Dev local (docker-compose) : port 8010.
VITE_API_URL=http://127.0.0.1:8010

# Chemin du backoffice admin — jamais "/admin" en dur, jamais commité en prod
# avec une vraie valeur (voir ROADMAP_ADMIN.md A3). Sans cette variable au
# build, les routes admin ne sont pas montées du tout (404, pas de surface
# à scanner). Exemple pour le dev local uniquement :
# VITE_ADMIN_PATH=ct-8f3ka2z9

# Domaine de production (sans slash final), utilisé dans index.html pour le
# canonical/Open Graph/Twitter card (ROADMAP_PUBLIC_SEO.md S1.1) et à
# reprendre tel quel dans public/robots.txt (Sitemap:) et public/sitemap.xml
# (<loc>) au build. AUCUN domaine réel n'existe encore pour ce projet —
# à renseigner avant la mise en ligne, sinon canonical/OG pointent vers un
# placeholder cassé.
VITE_SITE_URL=https://TODO-DOMAINE-PRODUCTION-A-DEFINIR.example
